{
  "schema_version": "1.0.0",
  "default_run_status": "draft",
  "require_account_binding": true,
  "require_confirmed_config": true,
  "authorization_defaults": {
    "like": true,
    "favorite": true,
    "comment": true,
    "follow": true,
    "not_interested": true,
    "profile_visit": false
  },
  "interaction_policy_defaults": {
    "profile_sampling": {"rate": 0, "max_total": 0}
  },
  "stop_on_account_mismatch": true,
  "stop_on_unknown_page_state": false,
  "persist_after_each_observation": true
}
